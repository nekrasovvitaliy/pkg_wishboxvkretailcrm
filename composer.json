{
    "name": "wishbox/pkg-wishboxvkretailcrm",
    "description": "Joomla integration between VK Market and RetailCRM",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.5",
        "retailcrm/api-client-php": "^6.15"
    },
    "require-dev": {
        "joomla/registry": "^3.0",
        "nyholm/psr7": "^1.8",
        "php-http/curl-client": "^2.3",
        "phpunit/phpunit": "^12.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "WishboxVkRetailCrmLibrary\\": "lib_wishboxvkretailcrm/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "civicrm/composer-compile-plugin": false,
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:integration": "phpunit --configuration phpunit.integration.xml.dist",
        "retailcrm:generate-models": "@php -d error_reporting=24575 vendor/retailcrm/api-client-php/bin/retailcrm-client models:generate --all",
        "post-install-cmd": [
            "@retailcrm:generate-models"
        ],
        "post-update-cmd": [
            "@retailcrm:generate-models"
        ]
    }
}
